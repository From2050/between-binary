---
import '../../world/world.css';
import { destinations } from '../../world/journey';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="A quiet path beneath a sky of human possibility. Stories by the fire, ideas in the grove, experiments in the workshop." />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=Source+Serif+4:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />
  <title>The quiet between | Between Binary</title>
</head>
<body>
  <canvas id="world-canvas" tabindex="0" aria-label="Night landscape. Drag or use arrow keys to look around. Click the fire, cabin, garden or bright stars to explore. Escape returns to the path."></canvas>
  <div class="vignette" aria-hidden="true"></div>
  <header class="world-header">
    <a class="wordmark" href="/"><span>BETWEEN BINARY</span><small>A FIELD OF POSSIBILITIES</small></a>
    <div id="world-controls" hidden>
      <button id="motion-toggle" aria-pressed="false">Pause motion</button>
      <button id="sound-toggle" aria-pressed="false">Sound off</button>
      <label class="volume-label">Volume <input id="volume" type="range" min="0" max="100" value="22" /></label>
    </div>
  </header>
  <main>
    <section id="arrival" aria-labelledby="arrival-title">
      <p class="eyebrow">A NIGHT WALK / BETWEEN BINARY</p>
      <h1 id="arrival-title">A little quiet.<br/>A wider <em>world.</em></h1>
      <p class="arrival-copy">Stories by the fire. Ideas taking root.<br/>A light on in the workshop.<br/>Above it all, the people who made this possible.</p>
      <div class="arrival-actions">
        <button id="enter-sound" class="primary" disabled>Preparing the path…</button>
        <button id="enter-quiet" class="quiet" disabled>Enter quietly <span aria-hidden="true">↗</span></button>
      </div>
      <p class="arrival-note">Take your time. There is no right way through.</p>
      <p id="loading" role="status">Gathering the night…</p>
    </section>
    <section id="place-card" hidden aria-labelledby="place-title">
      <button id="close-card" aria-label="Close place information">×</button>
      <p id="place-eyebrow" class="eyebrow"></p>
      <h2 id="place-title"></h2>
      <p id="place-description"></p>
      <div id="star-picker" hidden>
        <label for="star-select">Meet someone in the sky</label>
        <div class="star-row"><select id="star-select"><option value="" disabled selected>Choose a person</option></select><button id="next-star" aria-label="Meet the next person">→</button></div>
      </div>
      <a id="place-link" class="reading-link" href="/">Explore</a>
    </section>
    <section id="fallback" hidden aria-labelledby="fallback-title">
      <p class="eyebrow">THE PATH IS STILL HERE</p>
      <h1 id="fallback-title">A quieter way in.</h1>
      <p>This browser could not open the night landscape. The stories, notes, and experiments are all here.</p>
      <nav aria-label="Explore without 3D"><a href="/thoughts/">Thoughts ↗</a><a href="/garden/">Garden ↗</a><a href="/lab/">Lab ↗</a></nav>
      <button onclick="location.reload()">Try the landscape again</button>
    </section>
    <noscript><div class="no-script">Explore <a href="/thoughts/">Thoughts</a>, <a href="/garden/">Garden</a>, or <a href="/lab/">Lab</a>. JavaScript is needed for the landscape.</div></noscript>
  </main>
  <div id="star-focus" hidden aria-hidden="true"></div>
  <div id="tooltip" hidden><strong id="tooltip-name"></strong><span id="tooltip-role"></span></div>
  <footer id="wayfinding" hidden>
    <p id="journey-status" role="status" aria-live="polite">Drag to look around. Touch the fire, the house, or a bright star.</p>
    <div class="way-actions">
      <button id="return-clearing" hidden aria-label="Return to the front clearing">← Back to clearing</button>
    <details id="field-guide"><summary>Field guide <span aria-hidden="true">＋</span></summary><nav class="destinations" aria-label="Places along the path">
      <button id="return-path" aria-label="Return to the beginning of the path"><span aria-hidden="true">⌂</span><small>The path</small></button>
      {Object.entries(destinations).map(([id,d])=><button data-destination={id} aria-pressed="false"><span class="destination-number">{d.number}</span><span>{d.name}</span><small>{d.collection}</small></button>)}
    </nav>
      <p class="music-credit">Music: <a href="https://incompetech.com/music/royalty-free/index.html?isrc=USUAN1100224" target="_blank" rel="noopener">Friday Morning — Kevin MacLeod</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a></p>
    </details>
    </div>
  </footer>
  <script>
    function fallback(error: unknown) {
      console.error('World could not start', error);
      document.getElementById('arrival')!.hidden = true;
      document.getElementById('fallback')!.hidden = false;
      document.getElementById('world-controls')!.hidden = true;
      document.getElementById('wayfinding')!.hidden = true;
    }
    import('../../world/scene').then(({initWorld})=>initWorld()).catch(fallback);
  </script>
</body>
</html>
