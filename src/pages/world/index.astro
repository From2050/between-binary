---
// ─── /world/ — the wilderness walk ───
// A 3D gateway shaped by the Civilization Star Map vision: no walls, no UI chrome,
// just terrain underfoot and sky overhead. A path crosses open country at night and
// passes three places — a fire to tell stories by, a grove that grows, and a
// threshold to step through. Standalone page (no Layout) so the WebGL scene owns
// the only render loop.
const title = 'World | Between Binary';
const description =
	'A walk through open country at night — the fire, the grove, and the threshold, under a sky of the people who built what we know.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700&family=Space+Grotesk:wght@300;500;700&family=Source+Serif+4:ital,opsz,wght@1,8..60,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<canvas id="world-canvas"></canvas>

		<!-- Overlay UI -->
		<div id="vignette"></div>
		<div id="world-title">between binary</div>
		<a id="back-link" href="/">← Between Binary</a>
		<div id="hint">Drag to look around · Click a place to enter</div>
		<div id="tooltip" hidden>
			<div id="tooltip-name"></div>
			<div id="tooltip-role"></div>
		</div>
		<div id="loading">entering the world…</div>

		<style>
			html,
			body {
				margin: 0;
				height: 100%;
				overflow: hidden;
				background: #07040f;
				font-family: 'Outfit', sans-serif;
				color: #fff;
			}
			#world-canvas {
				position: fixed;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
				cursor: grab;
			}
			#vignette {
				position: fixed;
				inset: 0;
				z-index: 5;
				pointer-events: none;
				background: radial-gradient(ellipse at 50% 45%, transparent 48%, rgba(3, 1, 9, 0.68) 100%);
			}
			#world-title {
				position: fixed;
				top: 15%;
				left: 50%;
				transform: translateX(-50%);
				z-index: 6;
				pointer-events: none;
				font-family: 'Source Serif 4', serif;
				font-style: italic;
				font-size: clamp(22px, 3.2vw, 38px);
				letter-spacing: 0.35em;
				color: rgba(255, 226, 189, 0.82);
				text-shadow: 0 0 30px rgba(255, 190, 120, 0.3);
				opacity: 0;
				animation: title-breathe 8s ease-in-out 1.4s forwards;
			}
			@keyframes title-breathe {
				0% { opacity: 0; }
				22% { opacity: 1; }
				72% { opacity: 1; }
				100% { opacity: 0; }
			}
			#back-link {
				position: fixed;
				top: 20px;
				left: 24px;
				z-index: 10;
				color: rgba(255, 220, 180, 0.9);
				text-decoration: none;
				font-family: 'Space Grotesk', monospace;
				font-size: 14px;
				letter-spacing: 0.1em;
				padding: 8px 14px;
				border: 1px solid rgba(255, 200, 150, 0.22);
				border-radius: 999px;
				background: rgba(12, 8, 28, 0.5);
				backdrop-filter: blur(8px);
			}
			#back-link:hover {
				background: rgba(255, 200, 150, 0.12);
			}
			#hint {
				position: fixed;
				bottom: 24px;
				left: 50%;
				transform: translateX(-50%);
				z-index: 10;
				font-size: 13px;
				letter-spacing: 0.08em;
				color: rgba(255, 255, 255, 0.5);
				background: rgba(12, 8, 28, 0.5);
				padding: 8px 18px;
				border-radius: 999px;
				border: 1px solid rgba(255, 255, 255, 0.07);
				backdrop-filter: blur(8px);
				pointer-events: none;
				white-space: nowrap;
			}
			#tooltip {
				position: fixed;
				z-index: 20;
				pointer-events: none;
				background: rgba(8, 6, 16, 0.86);
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 10px;
				padding: 8px 12px;
				backdrop-filter: blur(10px);
				max-width: 240px;
			}
			#tooltip-name {
				font-weight: 700;
				font-size: 14px;
			}
			#tooltip-role {
				font-size: 11px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				opacity: 0.7;
				margin-top: 2px;
			}
			#loading {
				position: fixed;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 30;
				background: #07040f;
				color: rgba(255, 220, 180, 0.8);
				font-family: 'Space Grotesk', monospace;
				letter-spacing: 0.2em;
				font-size: 14px;
				transition: opacity 1s ease;
			}
			#loading.done {
				opacity: 0;
				pointer-events: none;
			}
		</style>

		<script>
			import * as THREE from 'three';
			import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
			import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
			import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
			import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';
			import { civilizationStars } from '../../data/civilizationStars';

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// ─── Renderer / scene / camera ───
			const canvas = document.getElementById('world-canvas') as HTMLCanvasElement;
			const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
			renderer.setSize(window.innerWidth, window.innerHeight);
			renderer.toneMapping = THREE.ACESFilmicToneMapping;
			renderer.toneMappingExposure = 1.0;

			const scene = new THREE.Scene();
			scene.fog = new THREE.FogExp2(0x140c28, 0.0092);

			const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 420);
			camera.position.set(0, 1.7, 6);
			camera.rotation.order = 'YXZ';

			const composer = new EffectComposer(renderer);
			composer.addPass(new RenderPass(scene, camera));
			const bloom = new UnrealBloomPass(
				new THREE.Vector2(window.innerWidth, window.innerHeight),
				0.42, // strength — restrained, so only genuinely hot things bloom
				0.6, // radius
				0.34 // threshold
			);
			composer.addPass(bloom);
			composer.addPass(new OutputPass());

			// ─── Seeded noise (terrain + scatter) ───
			function hash2(x: number, y: number) {
				let h = Math.imul(x, 374761393) + Math.imul(y, 668265263);
				h = Math.imul(h ^ (h >>> 13), 1274126177);
				return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
			}
			function vnoise2(x: number, y: number) {
				const xi = Math.floor(x);
				const yi = Math.floor(y);
				const xf = x - xi;
				const yf = y - yi;
				const u = xf * xf * (3 - 2 * xf);
				const v = yf * yf * (3 - 2 * yf);
				const a = hash2(xi, yi);
				const b = hash2(xi + 1, yi);
				const c = hash2(xi, yi + 1);
				const d = hash2(xi + 1, yi + 1);
				return (a * (1 - u) + b * u) * (1 - v) + (c * (1 - u) + d * u) * v;
			}
			function fbm2(x: number, y: number, oct = 4) {
				let s = 0;
				let a = 0.5;
				let f = 1;
				for (let i = 0; i < oct; i++) {
					s += a * vnoise2(x * f, y * f);
					f *= 2.07;
					a *= 0.5;
				}
				return s;
			}
			const rng = (() => {
				let s = 42;
				return () => ((s = (s * 16807) % 2147483647), s / 2147483647);
			})();
			const smoothstep = (e0: number, e1: number, x: number) => {
				const t = Math.max(0, Math.min(1, (x - e0) / (e1 - e0)));
				return t * t * (3 - 2 * t);
			};

			// ─── The path: where the walk goes, and what it keeps flat ───
			const FIRE_POS = new THREE.Vector3(6.2, 0, -7);
			const GROVE_POS = new THREE.Vector3(-9, 0, -12);
			const GATE_POS = new THREE.Vector3(0, 0, -22);

			const pathSegments: [number, number, number, number][] = [
				[0, 8, 0, -22], // the main walk, out toward the threshold
				[0, 0, FIRE_POS.x, FIRE_POS.z], // branch to the fire
				[0, -7, GROVE_POS.x, GROVE_POS.z], // branch to the grove
			];

			function distToPath(x: number, z: number) {
				let best = Infinity;
				for (const [x1, z1, x2, z2] of pathSegments) {
					const dx = x2 - x1;
					const dz = z2 - z1;
					const t = Math.max(0, Math.min(1, ((x - x1) * dx + (z - z1) * dz) / (dx * dx + dz * dz)));
					const px = x1 + dx * t;
					const pz = z1 + dz * t;
					best = Math.min(best, Math.hypot(x - px, z - pz));
				}
				return best;
			}

			// Rolling country that rises into hills toward the horizon,
			// staying level along the path so the walk reads as walkable ground.
			function terrainHeight(x: number, z: number) {
				const d = Math.hypot(x, z);
				const far = smoothstep(28, 100, d);
				const amp = 0.45 + far * far * 26;
				let h = (fbm2(x * 0.017 + 3.1, z * 0.017 + 7.7) - 0.5) * 2 * amp;
				// ridged detail so distant hills get silhouette structure
				const ridge = Math.pow(Math.max(0, fbm2(x * 0.009 + 40, z * 0.009 + 61) - 0.34), 1.4);
				h += far * ridge * 40;
				return h * smoothstep(0, 1, Math.min(1, distToPath(x, z) / 13));
			}

			// ─── Ground ───
			{
				const SIZE = 300;
				const SEG = 150;
				const geo = new THREE.PlaneGeometry(SIZE, SIZE, SEG, SEG);
				const pos = geo.attributes.position as THREE.BufferAttribute;
				const colors = new Float32Array(pos.count * 3);
				const moss = new THREE.Color(0x121b1c);
				const rock = new THREE.Color(0x14102a);
				const c = new THREE.Color();
				for (let i = 0; i < pos.count; i++) {
					const x = pos.getX(i);
					const y = pos.getY(i); // plane is still in XY here
					const h = terrainHeight(x, -y);
					pos.setZ(i, h);
					const t = smoothstep(0.2, 0.75, fbm2(x * 0.05 + 11, -y * 0.05 + 5));
					c.copy(moss).lerp(rock, t);
					colors[i * 3] = c.r;
					colors[i * 3 + 1] = c.g;
					colors[i * 3 + 2] = c.b;
				}
				geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
				geo.computeVertexNormals();
				const ground = new THREE.Mesh(
					geo,
					new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 1, metalness: 0 })
				);
				ground.rotation.x = -Math.PI / 2;
				scene.add(ground);
			}

			// ─── Lights ───
			scene.add(new THREE.AmbientLight(0x8f9bd8, 0.3));
			const moonLight = new THREE.DirectionalLight(0xb9ccff, 0.5);
			moonLight.position.set(-45, 40, -35);
			scene.add(moonLight);

			// ─── Sky: fully procedural GLSL ───
			// ─── The celestial sphere ───
			// The painted dome, the civilization stars and the moon are all children of
			// this one group, so they turn as a single rigid body. Nothing in the sky can
			// drift against anything else in it, because nothing rotates on its own.
			const SKY_SPIN = 0.0065;
			const starsGroup = new THREE.Group();
			scene.add(starsGroup);
			const skyUniforms = { uTime: { value: 0 } };
			{
				const skyMat = new THREE.ShaderMaterial({
					side: THREE.BackSide,
					depthWrite: false,
					fog: false,
					uniforms: skyUniforms,
					vertexShader: `
						varying vec3 vDir;
						varying vec3 vWorld;
						void main() {
							vDir = position;                                   // turns with the sky
							vWorld = (modelMatrix * vec4(position, 1.0)).xyz;  // stays with the ground
							gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
						}
					`,
					fragmentShader: `
						precision highp float;
						uniform float uTime;
						varying vec3 vDir;
						varying vec3 vWorld;

						float hash13(vec3 p){ p = fract(p*0.1031); p += dot(p, p.zyx+31.32); return fract((p.x+p.y)*p.z); }
						vec3 hash33(vec3 p){ p = fract(p*vec3(0.1031,0.1030,0.0973)); p += dot(p,p.yxz+33.33); return fract((p.xxy+p.yxx)*p.zyx); }
						float vnoise(vec3 p){
							vec3 i = floor(p), f = fract(p);
							vec3 u = f*f*(3.0-2.0*f);
							return mix(
								mix(mix(hash13(i), hash13(i+vec3(1,0,0)), u.x),
									mix(hash13(i+vec3(0,1,0)), hash13(i+vec3(1,1,0)), u.x), u.y),
								mix(mix(hash13(i+vec3(0,0,1)), hash13(i+vec3(1,0,1)), u.x),
									mix(hash13(i+vec3(0,1,1)), hash13(i+vec3(1,1,1)), u.x), u.y),
								u.z);
						}
						float fbm(vec3 p){ float v=0.0; float a=0.5; for(int k=0;k<4;k++){ v+=a*vnoise(p); p*=2.13; a*=0.5; } return v; }

						float starLayer(vec3 d, float scale, float density, float twSpeed){
							vec3 p = d*scale;
							vec3 id = floor(p);
							vec3 gv = fract(p)-0.5;
							vec3 rnd = hash33(id);
							float sel = step(1.0-density, rnd.z);
							vec3 offs = (rnd-0.5)*0.72;
							float dist = length(gv-offs);
							float m = smoothstep(0.13, 0.0, dist);
							float tw = 0.7 + 0.3*sin(uTime*twSpeed*(0.5+rnd.x) + rnd.y*6.2831);
							return m*sel*tw;
						}

						void main(){
							vec3 d = normalize(vDir);    // celestial frame — stars, milky way, nebulae
							vec3 w = normalize(vWorld);  // world frame — horizon, distant glow, aurora
							float h = w.y;

							vec3 zenith = vec3(0.010, 0.007, 0.038);
							vec3 horizon = vec3(0.085, 0.055, 0.20);
							vec3 col = mix(horizon, zenith, smoothstep(0.0, 0.42, h));

							// warm glow low on one side — the world continues past the hills
							float glow = max(0.0, dot(normalize(w.xz + vec2(1e-4)), vec2(-0.5, -0.866)));
							col += vec3(0.38, 0.20, 0.10) * pow(glow, 7.0) * (1.0 - smoothstep(0.0, 0.18, h)) * 0.5;

							// milky way: tilted band with dust lanes
							vec3 n = normalize(vec3(0.55, 0.28, 0.78));
							float planeDist = abs(dot(d, n));
							float band = exp(-planeDist*planeDist*38.0);
							float cloud = fbm(d*5.0);
							float dust = fbm(d*9.0 + vec3(4.7, 1.3, 8.1));
							vec3 mwCol = mix(vec3(0.42, 0.32, 0.85), vec3(0.86, 0.60, 0.95), cloud);
							mwCol = mix(mwCol, vec3(0.35, 0.70, 0.85), smoothstep(0.55, 0.85, fbm(d*3.0 + 7.0)));
							float mw = band * (0.15 + 0.85*cloud);
							mw *= 1.0 - 0.8*smoothstep(0.40, 0.75, dust);
							col += mwCol * mw * 0.28 * smoothstep(-0.05, 0.12, h);

							// faint nebula patches
							float neb = fbm(d*3.2 + vec3(11.0));
							col += vec3(0.28, 0.15, 0.48) * pow(neb, 4.5) * 0.5 * smoothstep(0.0, 0.3, h);

							// twinkling star field
							float fade = smoothstep(-0.02, 0.16, h);
							float s = starLayer(d, 30.0, 0.10, 1.4)*0.85
									+ starLayer(d, 58.0, 0.07, 2.0)*0.50
									+ starLayer(d, 100.0, 0.05, 2.8)*0.28;
							col += vec3(0.85, 0.88, 1.0) * s * fade;
							float sb = starLayer(d, 18.0, 0.02, 1.0);
							col += vec3(1.0, 0.85, 0.65) * sb * 0.9 * fade;

							// aurora curtain, low on one side
							float aBand = smoothstep(0.02, 0.16, h) * (1.0 - smoothstep(0.28, 0.55, h));
							float g = max(0.0, dot(normalize(w.xz + vec2(1e-4)), normalize(vec2(0.85, 0.4))));
							float curtain = fbm(vec3(w.x*4.0, w.z*4.0, uTime*0.045));
							col += vec3(0.12, 0.75, 0.55) * aBand * pow(g, 3.0) * pow(curtain, 2.5) * 0.32;

							gl_FragColor = vec4(col, 1.0);
						}
					`,
				});
				starsGroup.add(new THREE.Mesh(new THREE.SphereGeometry(200, 48, 24), skyMat));
			}

			// ─── Texture loading (AI-generated art lives in public/images/world/) ───
			const loadingEl = document.getElementById('loading')!;
			const texManager = new THREE.LoadingManager(
				() => loadingEl.classList.add('done'),
				undefined,
				() => loadingEl.classList.add('done')
			);
			setTimeout(() => loadingEl.classList.add('done'), 5000); // safety net
			const texLoader = new THREE.TextureLoader(texManager);
			function loadArt(url: string) {
				const tex = texLoader.load(url);
				tex.colorSpace = THREE.SRGBColorSpace;
				return tex;
			}

			function makeGlowTexture() {
				const cv = document.createElement('canvas');
				cv.width = cv.height = 64;
				const ctx = cv.getContext('2d')!;
				const grad = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
				grad.addColorStop(0, 'rgba(255,255,255,1)');
				grad.addColorStop(0.35, 'rgba(255,255,255,0.8)');
				grad.addColorStop(1, 'rgba(255,255,255,0)');
				ctx.fillStyle = grad;
				ctx.fillRect(0, 0, 64, 64);
				return new THREE.CanvasTexture(cv);
			}
			const glowTexture = makeGlowTexture();

			// ─── The sky's people: distant pinpoints, not nearby orbs ───
			// Screen-space sized (sizeAttenuation off) so they read as stars at any depth.
			const STAR_RADIUS = 192;

			// Fixed to the celestial sphere: their only motion is the sky's own rotation,
			// which is what keeps them reading as far away. Brightness twinkles per star —
			// that part is real; independent drift is not, and made them look nearby.
			const civMat = new THREE.ShaderMaterial({
				transparent: true,
				blending: THREE.AdditiveBlending,
				depthWrite: false,
				fog: false,
				uniforms: {
					uTime: { value: 0 },
					uMap: { value: glowTexture },
					uSize: { value: 6 * renderer.getPixelRatio() },
				},
				vertexShader: `
					attribute vec3 color;
					attribute float phase;
					uniform float uTime;
					uniform float uSize;
					varying vec3 vColor;
					varying float vTw;
					void main() {
						vColor = color;
						vTw = 0.74 + 0.26 * sin(uTime * (0.5 + fract(phase) * 0.9) + phase * 6.2831);
						gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
						gl_PointSize = uSize;
					}
				`,
				fragmentShader: `
					precision highp float;
					uniform sampler2D uMap;
					varying vec3 vColor;
					varying float vTw;
					void main() {
						float a = texture2D(uMap, gl_PointCoord).a * vTw;
						gl_FragColor = vec4(vColor * a, a);
					}
				`,
			});
			{
				const n = civilizationStars.length;
				const pos = new Float32Array(n * 3);
				const colors = new Float32Array(n * 3);
				const phase = new Float32Array(n);
				const c = new THREE.Color();
				civilizationStars.forEach((star, i) => {
					const az = rng() * Math.PI * 2;
					const el = 0.22 + rng() * 0.95;
					pos[i * 3] = STAR_RADIUS * Math.cos(el) * Math.cos(az);
					pos[i * 3 + 1] = STAR_RADIUS * Math.sin(el);
					pos[i * 3 + 2] = STAR_RADIUS * Math.cos(el) * Math.sin(az);
					phase[i] = rng();
					c.set(star.color);
					colors[i * 3] = c.r;
					colors[i * 3 + 1] = c.g;
					colors[i * 3 + 2] = c.b;
				});
				const geo = new THREE.BufferGeometry();
				geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
				geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
				geo.setAttribute('phase', new THREE.BufferAttribute(phase, 1));
				const points = new THREE.Points(geo, civMat);
				points.name = 'civ-stars';
				points.frustumCulled = false;
				starsGroup.add(points);
			}

			// The moon, far off behind the hills
			{
				const az = 3.7;
				const el = 0.62;
				const p = new THREE.Vector3(
					STAR_RADIUS * Math.cos(el) * Math.cos(az),
					STAR_RADIUS * Math.sin(el),
					STAR_RADIUS * Math.cos(el) * Math.sin(az)
				);
				// a real lunar disc, not a light bulb — dimmed so it doesn't bloom out
				const disc = new THREE.Sprite(
					new THREE.SpriteMaterial({
						map: loadArt('/images/world/moon.png'),
						color: 0x9aa4b8, // knock the exposure down; bloom does the rest
						transparent: true,
						depthWrite: false,
						fog: false,
					})
				);
				disc.position.copy(p);
				disc.scale.set(13, 13, 1);
				starsGroup.add(disc);

				// the faintest atmosphere around it
				const halo = new THREE.Sprite(
					new THREE.SpriteMaterial({
						map: glowTexture,
						color: 0x8fa4d8,
						transparent: true,
						opacity: 0.07,
						blending: THREE.AdditiveBlending,
						depthWrite: false,
						fog: false,
					})
				);
				halo.position.copy(p);
				halo.scale.set(26, 26, 1);
				starsGroup.add(halo);
			}

			// ─── Places ───
			type Place = {
				group: THREE.Group;
				hitBox: THREE.Mesh;
				lights: THREE.PointLight[];
				baseIntensity: number[];
				label: THREE.Sprite;
				href: string;
				hint: string;
			};
			const places: Place[] = [];

			function makeLabel(text: string, color: string) {
				const cv = document.createElement('canvas');
				cv.width = 512;
				cv.height = 128;
				const ctx = cv.getContext('2d')!;
				ctx.font = '500 44px "Space Grotesk", sans-serif';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				ctx.letterSpacing = '10px';
				ctx.shadowColor = color;
				ctx.shadowBlur = 18;
				ctx.fillStyle = color;
				ctx.fillText(text, 256, 64);
				const sprite = new THREE.Sprite(
					new THREE.SpriteMaterial({
						map: new THREE.CanvasTexture(cv),
						transparent: true,
						opacity: 0.42, // quiet until you look at it
						depthWrite: false,
						fog: false,
					})
				);
				sprite.scale.set(4.4, 1.1, 1);
				return sprite;
			}

			function registerPlace(
				group: THREE.Group,
				href: string,
				hint: string,
				lights: THREE.PointLight[],
				label: THREE.Sprite,
				hitSize: [number, number, number],
				hitCenterY: number
			) {
				const hitBox = new THREE.Mesh(
					new THREE.BoxGeometry(...hitSize),
					new THREE.MeshBasicMaterial({ visible: false })
				);
				hitBox.position.y = hitCenterY;
				group.add(hitBox);
				group.add(label);
				places.push({
					group,
					hitBox,
					lights,
					baseIntensity: lights.map((l) => l.intensity),
					label,
					href,
					hint,
				});
				scene.add(group);
			}

			// ── The fire: where the long-form writing is told ──
			let flameMesh: THREE.Mesh;
			let flameMat: THREE.ShaderMaterial;
			let fireLight: THREE.PointLight;
			const pageSprites: THREE.Sprite[] = [];
			const emberGeo = new THREE.BufferGeometry();
			const EMBER_COUNT = 70;
			const emberSeed = new Float32Array(EMBER_COUNT * 3);
			{
				const g = new THREE.Group();
				g.position.copy(FIRE_POS);

				// ring of stones
				const stoneMat = new THREE.MeshStandardMaterial({ color: 0x2b2a3a, roughness: 1, flatShading: true });
				for (let i = 0; i < 9; i++) {
					const a = (i / 9) * Math.PI * 2 + rng() * 0.2;
					const s = new THREE.Mesh(new THREE.DodecahedronGeometry(0.24 + rng() * 0.12, 0), stoneMat);
					s.position.set(Math.cos(a) * 1.25, 0.1, Math.sin(a) * 1.25);
					s.rotation.set(rng() * 3, rng() * 3, rng() * 3);
					g.add(s);
				}

				// painted logs (cut from the generated fire art)
				const logs = new THREE.Sprite(
					new THREE.SpriteMaterial({
						map: loadArt('/images/world/logs.png'),
						transparent: true,
						depthWrite: false,
					})
				);
				logs.scale.set(1.7, 1.7 / 1.51, 1); // 1.51 = the art's aspect
				logs.position.y = 0.5;
				g.add(logs);

				// The flame is drawn, not scaled: upward-scrolling domain-warped noise
				// eats into a teardrop body, so the shape actually churns and licks.
				flameMat = new THREE.ShaderMaterial({
					transparent: true,
					blending: THREE.AdditiveBlending,
					depthWrite: false,
					fog: false,
					uniforms: { uTime: { value: 0 }, uIntensity: { value: 1 } },
					vertexShader: `
						varying vec2 vUv;
						void main() {
							vUv = uv;
							gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
						}
					`,
					fragmentShader: `
						precision highp float;
						uniform float uTime;
						uniform float uIntensity;
						varying vec2 vUv;

						float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
						float noise(vec2 p){
							vec2 i = floor(p), f = fract(p);
							vec2 u = f*f*(3.0-2.0*f);
							return mix(mix(hash(i), hash(i+vec2(1,0)), u.x),
									   mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), u.x), u.y);
						}
						float fbm(vec2 p){
							float v = 0.0, a = 0.5;
							for (int i = 0; i < 5; i++){ v += a*noise(p); p *= 2.03; a *= 0.5; }
							return v;
						}

						void main(){
							vec2 uv = vUv;
							float y = uv.y;

							// rising turbulence, domain-warped so it curls instead of streaking
							vec2 q = vec2(uv.x*4.5, uv.y*3.0 - uTime*1.9);
							float warp = fbm(q*1.9 + uTime*0.25);
							float n = fbm(q + warp*0.75);

							// the whole column leans and sways as it burns
							float sway = (fbm(vec2(uv.y*1.6 - uTime*0.8, uTime*0.3)) - 0.5) * 0.22 * y;
							float d = abs(uv.x - 0.5 - sway);

							// teardrop body, narrowing as it rises
							float width = 0.40 * (1.0 - y*0.78);
							float body = 1.0 - smoothstep(width*0.25, width, d);
							body *= 1.0 - smoothstep(0.46, 1.0, y);  // dissolve near the top
							body *= smoothstep(0.0, 0.08, y);        // sit down into the logs

							// noise bites deeper the higher up you go, so tongues break off
							float f = body - (1.0 - n) * (0.10 + y*1.15);
							f = smoothstep(0.02, 0.30, f) * uIntensity;

							// warm ramp — a yellow heart, never a white blob
							vec3 col = mix(vec3(0.52, 0.05, 0.005), vec3(0.95, 0.30, 0.02), smoothstep(0.04, 0.32, f));
							col = mix(col, vec3(1.0, 0.62, 0.13), smoothstep(0.32, 0.62, f));
							col = mix(col, vec3(1.0, 0.84, 0.42), smoothstep(0.70, 0.98, f));

							gl_FragColor = vec4(col, f * 0.7);
						}
					`,
				});
				flameMesh = new THREE.Mesh(new THREE.PlaneGeometry(1.5, 2.3), flameMat);
				flameMesh.position.y = 1.45;
				// cylindrical billboard: face the viewer, stay upright
				flameMesh.rotation.y = Math.atan2(
					camera.position.x - FIRE_POS.x,
					camera.position.z - FIRE_POS.z
				);
				g.add(flameMesh);

				fireLight = new THREE.PointLight(0xff9142, 11, 24, 2);
				fireLight.position.set(0, 1.1, 0);
				g.add(fireLight);

				// embers rising from the flame
				{
					const pos = new Float32Array(EMBER_COUNT * 3);
					for (let i = 0; i < EMBER_COUNT; i++) {
						emberSeed[i * 3] = rng() * Math.PI * 2; // angle
						emberSeed[i * 3 + 1] = rng(); // phase
						emberSeed[i * 3 + 2] = 0.35 + rng() * 0.5; // speed
						pos[i * 3] = 0;
						pos[i * 3 + 1] = 1;
						pos[i * 3 + 2] = 0;
					}
					emberGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
					const embers = new THREE.Points(
						emberGeo,
						new THREE.PointsMaterial({
							color: 0xffb765,
							size: 0.075,
							map: glowTexture,
							transparent: true,
							opacity: 0.6,
							blending: THREE.AdditiveBlending,
							depthWrite: false,
						})
					);
					embers.frustumCulled = false;
					g.add(embers);
				}

				// the writing itself — illustrated pages carried up on the heat
				for (let i = 0; i < 6; i++) {
					const s = new THREE.Sprite(
						new THREE.SpriteMaterial({
							map: loadArt(`/images/world/note-${i}.jpg`),
							transparent: true,
							opacity: 0.9,
							depthWrite: false,
						})
					);
					s.scale.set(0.72, 0.72, 1);
					// laid out here too, so they still read as a ring when motion is off
					const a0 = (i / 6) * Math.PI * 2;
					s.position.set(Math.cos(a0) * 1.7, 1.7 + (i % 3) * 0.5, Math.sin(a0) * 1.7);
					pageSprites.push(s);
					g.add(s);
				}

				const label = makeLabel('THOUGHTS', '#ffd7a8');
				label.position.set(0, 4.6, 0);
				registerPlace(g, '/thoughts/', 'Sit by the fire — long-form writing', [fireLight], label, [5, 5, 5], 2);
			}

			// ── The grove: seedling → budding → evergreen, the garden's own growth model ──
			const plantSprites: { sprite: THREE.Sprite; baseY: number; phase: number }[] = [];
			let groveLight: THREE.PointLight;
			{
				const g = new THREE.Group();
				g.position.copy(GROVE_POS);

				// the three stages, in the order the garden grows
				// [textureIndex, x, z, height, aspect] — aspects come from the cut-out art
				const stages: [number, number, number, number, number][] = [
					[0, 2.4, 1.5, 0.62, 1.059], // seedling
					[1, 0.3, 0.2, 2.4, 0.761], // budding
					[2, -2.8, -1.0, 5.6, 0.484], // evergreen
				];
				for (const [idx, x, z, hgt, aspect] of stages) {
					const sprite = new THREE.Sprite(
						new THREE.SpriteMaterial({
							map: loadArt(`/images/world/plant-${idx}.png`),
							transparent: true,
							depthWrite: false,
						})
					);
					sprite.scale.set(hgt * aspect, hgt, 1);
					sprite.position.set(x, hgt / 2, z);
					g.add(sprite);
					plantSprites.push({ sprite, baseY: hgt / 2, phase: rng() * 6.28 });
				}

				// undergrowth: glowing motes low in the grass
				{
					const N = 120;
					const pos = new Float32Array(N * 3);
					for (let i = 0; i < N; i++) {
						const a = rng() * Math.PI * 2;
						const d = 0.8 + rng() * 5;
						const x = Math.cos(a) * d;
						const z = Math.sin(a) * d * 0.85;
						pos[i * 3] = x;
						pos[i * 3 + 1] = 0.06 + rng() * 0.28;
						pos[i * 3 + 2] = z;
					}
					const geo = new THREE.BufferGeometry();
					geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
					g.add(
						new THREE.Points(
							geo,
							new THREE.PointsMaterial({
								color: 0x5eead4,
								size: 0.09,
								map: glowTexture,
								transparent: true,
								opacity: 0.45,
								blending: THREE.AdditiveBlending,
								depthWrite: false,
							})
						)
					);
				}

				groveLight = new THREE.PointLight(0x3ddba0, 4.5, 20, 2);
				groveLight.position.set(0, 2.4, 1.5);
				g.add(groveLight);

				const label = makeLabel('GARDEN', '#9df5cf');
				label.position.set(0, 6.6, 0);
				registerPlace(g, '/garden/', 'Into the grove — notes that keep growing', [groveLight], label, [8, 6.5, 6], 3);
			}

			// ── The workshop: a lit hut where the experiments actually happen ──
			let doorGlowMat: THREE.SpriteMaterial;
			let gateLight: THREE.PointLight;
			let windowMat: THREE.MeshBasicMaterial;
			{
				const g = new THREE.Group();
				g.position.copy(GATE_POS);
				g.rotation.y = 0.14;

				const W = 4.4, D = 3.6, WALL = 2.5; // wall footprint and height
				const timber = new THREE.MeshStandardMaterial({ color: 0x3a2c22, roughness: 1, flatShading: true });
				const roofMat = new THREE.MeshStandardMaterial({ color: 0x241c2e, roughness: 1, flatShading: true });

				// stacked log walls — each course is its own cylinder, so the silhouette
				// keeps the notched, hand-built look rather than reading as a box
				const COURSES = 7;
				const logR = WALL / COURSES / 2;
				for (let i = 0; i < COURSES; i++) {
					const y = logR + i * (WALL / COURSES);
					for (const [len, rotY, px, pz] of [
						[W, 0, 0, -D / 2],
						[W, 0, 0, D / 2],
						[D, Math.PI / 2, -W / 2, 0],
						[D, Math.PI / 2, W / 2, 0],
					] as const) {
						const log = new THREE.Mesh(new THREE.CylinderGeometry(logR, logR, len, 6), timber);
						log.rotation.set(Math.PI / 2, 0, 0);
						log.rotation.y = rotY;
						log.position.set(px, y, pz);
						g.add(log);
					}
				}

				// gable roof: two slabs and the triangles that close the ends
				const RISE = 1.5, SLAB = Math.hypot(W / 2 + 0.35, RISE);
				for (const sign of [-1, 1]) {
					const slab = new THREE.Mesh(new THREE.BoxGeometry(SLAB, 0.14, D + 0.8), roofMat);
					slab.position.set((sign * (W / 2 + 0.35)) / 2, WALL + RISE / 2, 0);
					slab.rotation.z = sign * -Math.atan2(RISE, W / 2 + 0.35);
					g.add(slab);
				}
				const gable = new THREE.Shape();
				gable.moveTo(-W / 2, 0);
				gable.lineTo(W / 2, 0);
				gable.lineTo(0, RISE);
				gable.closePath();
				for (const sign of [-1, 1]) {
					const end = new THREE.Mesh(new THREE.ShapeGeometry(gable), timber);
					end.position.set(0, WALL, (sign * D) / 2);
					g.add(end);
				}

				// chimney
				const chimney = new THREE.Mesh(new THREE.BoxGeometry(0.5, 1.5, 0.5), roofMat);
				chimney.position.set(-W / 2 + 0.9, WALL + RISE * 0.6, -D / 4);
				g.add(chimney);

				// the ornate door, set into the front wall
				const door = new THREE.Mesh(
					new THREE.PlaneGeometry(1.15, 1.95),
					new THREE.MeshBasicMaterial({
						map: loadArt('/images/world/door.jpg'),
						color: 0x7a6b58,
						transparent: true,
					})
				);
				door.position.set(0.55, 0.98, D / 2 + 0.04);
				g.add(door);

				// a window with the lamp on inside
				windowMat = new THREE.MeshBasicMaterial({ color: 0xffb85c });
				const win = new THREE.Mesh(new THREE.PlaneGeometry(0.85, 0.7), windowMat);
				win.position.set(-1.25, 1.45, D / 2 + 0.04);
				g.add(win);
				const mullion = new THREE.Mesh(
					new THREE.BoxGeometry(0.06, 0.72, 0.05),
					new THREE.MeshStandardMaterial({ color: 0x2a2118, roughness: 1 })
				);
				mullion.position.set(-1.25, 1.45, D / 2 + 0.07);
				g.add(mullion);

				// light spilling out onto the ground, not blasting the whole field
				doorGlowMat = new THREE.SpriteMaterial({
					map: glowTexture,
					color: 0xffb066,
					transparent: true,
					opacity: 0.09,
					blending: THREE.AdditiveBlending,
					depthWrite: false,
				});
				const spill = new THREE.Sprite(doorGlowMat);
				spill.position.set(-0.3, 1.2, D / 2 + 0.5);
				spill.scale.set(5.5, 4, 1);
				g.add(spill);

				gateLight = new THREE.PointLight(0xffb066, 5.5, 20, 2);
				gateLight.position.set(-0.3, 1.5, D / 2 + 1.1);
				g.add(gateLight);

				const label = makeLabel('LAB', '#ffd08a');
				label.position.set(0, WALL + RISE + 1.5, 0);
				registerPlace(g, '/lab/', 'Knock on the workshop — experiments in progress', [gateLight], label, [W + 1, WALL + RISE + 0.5, D + 1], (WALL + RISE) / 2);
			}

			// ─── The path itself: stones set into the ground ───
			const pathMats: THREE.MeshBasicMaterial[] = [];
			{
				const mat = new THREE.MeshBasicMaterial({
					map: glowTexture,
					color: 0xa691e8,
					transparent: true,
					opacity: 0.2,
					blending: THREE.AdditiveBlending,
					depthWrite: false,
				});
				pathMats.push(mat);
				const stoneMat = new THREE.MeshStandardMaterial({ color: 0x3a3552, roughness: 1, flatShading: true });
				for (const [x1, z1, x2, z2] of pathSegments) {
					const len = Math.hypot(x2 - x1, z2 - z1);
					const n = Math.max(4, Math.round(len / 1.5));
					for (let i = 0; i <= n; i++) {
						const t = i / n;
						const jx = (rng() - 0.5) * 0.75;
						const jz = (rng() - 0.5) * 0.75;
						const x = x1 + (x2 - x1) * t + jx;
						const z = z1 + (z2 - z1) * t + jz;
						const y = terrainHeight(x, z);
						const slab = new THREE.Mesh(
							new THREE.CylinderGeometry(0.34 + rng() * 0.16, 0.36 + rng() * 0.16, 0.1, 6),
							stoneMat
						);
						slab.position.set(x, y + 0.03, z);
						slab.rotation.y = rng() * 3;
						scene.add(slab);
						// faint light caught on the stone
						const halo = new THREE.Mesh(new THREE.CircleGeometry(0.34, 14), mat);
						halo.rotation.x = -Math.PI / 2;
						halo.position.set(x, y + 0.1, z);
						scene.add(halo);
					}
				}
			}

			// ─── Fireflies over the open ground ───
			const fireflyCount = 140;
			const fireflyBase = new Float32Array(fireflyCount * 3);
			const fireflyPhase = new Float32Array(fireflyCount);
			const fireflyGeo = new THREE.BufferGeometry();
			{
				const pos = new Float32Array(fireflyCount * 3);
				for (let i = 0; i < fireflyCount; i++) {
					const a = rng() * Math.PI * 2;
					const d = 3 + rng() * 26;
					const x = Math.cos(a) * d;
					const z = Math.sin(a) * d - 10;
					fireflyBase[i * 3] = x;
					fireflyBase[i * 3 + 1] = terrainHeight(x, z) + 0.5 + rng() * 2.4;
					fireflyBase[i * 3 + 2] = z;
					fireflyPhase[i] = rng() * Math.PI * 2;
					pos.set(fireflyBase.subarray(i * 3, i * 3 + 3), i * 3);
				}
				fireflyGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
				const flies = new THREE.Points(
					fireflyGeo,
					new THREE.PointsMaterial({
						color: 0xffe9a3,
						size: 0.11,
						map: glowTexture,
						transparent: true,
						opacity: 0.55,
						blending: THREE.AdditiveBlending,
						depthWrite: false,
					})
				);
				flies.frustumCulled = false;
				scene.add(flies);
			}

			// ─── Shooting stars ───
			type Meteor = {
				line: THREE.Line;
				mat: THREE.LineBasicMaterial;
				start: THREE.Vector3;
				dir: THREE.Vector3;
				t: number;
				life: number;
				active: boolean;
			};
			const meteors: Meteor[] = [];
			for (let i = 0; i < 3; i++) {
				const mat = new THREE.LineBasicMaterial({
					color: 0xcfe8ff,
					transparent: true,
					opacity: 0,
					blending: THREE.AdditiveBlending,
					depthWrite: false,
					fog: false,
				});
				const geo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
				const line = new THREE.Line(geo, mat);
				line.frustumCulled = false;
				scene.add(line);
				meteors.push({ line, mat, start: new THREE.Vector3(), dir: new THREE.Vector3(), t: 0, life: 0.9, active: false });
			}
			let nextMeteorAt = 4;
			function spawnMeteor(now: number) {
				const m = meteors.find((mm) => !mm.active);
				if (!m) return;
				const az = rng() * Math.PI * 2;
				const el = 0.5 + rng() * 0.6;
				const r = 150;
				m.start.set(r * Math.cos(el) * Math.cos(az), r * Math.sin(el), r * Math.cos(el) * Math.sin(az));
				m.dir
					.set(Math.cos(az + 2), -0.5 - rng() * 0.3, Math.sin(az + 2))
					.normalize()
					.multiplyScalar(70 + rng() * 40);
				m.t = now;
				m.life = 0.7 + rng() * 0.5;
				m.active = true;
			}

			// ─── Look controls ───
			let yaw = -0.2;
			let pitch = -1.0;
			let dragging = false;
			let moved = false;
			let lastX = 0;
			let lastY = 0;
			let downX = 0;
			let downY = 0;
			let introActive = !prefersReducedMotion;
			if (prefersReducedMotion) {
				yaw = 0;
				pitch = 0.02;
			}

			canvas.addEventListener('pointerdown', (e) => {
				dragging = true;
				moved = false;
				introActive = false;
				lastX = downX = e.clientX;
				lastY = downY = e.clientY;
				canvas.style.cursor = 'grabbing';
			});
			window.addEventListener('pointerup', () => {
				dragging = false;
				canvas.style.cursor = 'grab';
			});

			const raycaster = new THREE.Raycaster();
			raycaster.params.Points = { threshold: 5 };
			const pointer = new THREE.Vector2();
			const tooltip = document.getElementById('tooltip')!;
			const tooltipName = document.getElementById('tooltip-name')!;
			const tooltipRole = document.getElementById('tooltip-role')!;
			const hint = document.getElementById('hint')!;
			const defaultHint = hint.textContent;

			let hoveredPlace: Place | null = null;
			let hoveredStarIndex = -1;

			function pick(e: PointerEvent) {
				pointer.set((e.clientX / window.innerWidth) * 2 - 1, -(e.clientY / window.innerHeight) * 2 + 1);
				raycaster.setFromCamera(pointer, camera);

				hoveredPlace = null;
				let placeHitDist = Infinity;
				for (const place of places) {
					const hits = raycaster.intersectObject(place.hitBox, false);
					if (hits.length && hits[0].distance < placeHitDist) {
						placeHitDist = hits[0].distance;
						hoveredPlace = place;
					}
				}

				hoveredStarIndex = -1;
				if (!hoveredPlace) {
					const civ = starsGroup.getObjectByName('civ-stars')!;
					const hits = raycaster.intersectObject(civ, false);
					if (hits.length && hits[0].index !== undefined) hoveredStarIndex = hits[0].index;
				}

				if (hoveredStarIndex >= 0) {
					const star = civilizationStars[hoveredStarIndex];
					tooltipName.textContent = star.name;
					tooltipName.style.color = star.color;
					tooltipRole.textContent = `${star.role} · ${star.year}`;
					tooltip.hidden = false;
					tooltip.style.left = `${Math.min(e.clientX + 14, window.innerWidth - 250)}px`;
					tooltip.style.top = `${e.clientY + 14}px`;
				} else {
					tooltip.hidden = true;
				}

				hint.textContent = hoveredPlace ? hoveredPlace.hint : defaultHint;
				canvas.style.cursor = dragging ? 'grabbing' : hoveredPlace || hoveredStarIndex >= 0 ? 'pointer' : 'grab';
			}

			canvas.addEventListener('pointermove', (e) => {
				if (dragging) {
					yaw += (e.clientX - lastX) * 0.0035;
					pitch -= (e.clientY - lastY) * 0.0025;
					pitch = Math.max(-1.25, Math.min(0.35, pitch));
					lastX = e.clientX;
					lastY = e.clientY;
					if (Math.abs(e.clientX - downX) + Math.abs(e.clientY - downY) > 6) moved = true;
					tooltip.hidden = true;
				} else {
					pick(e);
				}
			});

			canvas.addEventListener('click', (e) => {
				if (moved) return;
				pick(e as PointerEvent);
				if (hoveredPlace) window.location.href = hoveredPlace.href;
				else if (hoveredStarIndex >= 0) window.location.href = '/lab/civilization-star-map/';
			});

			window.addEventListener('resize', () => {
				camera.aspect = window.innerWidth / window.innerHeight;
				camera.updateProjectionMatrix();
				renderer.setSize(window.innerWidth, window.innerHeight);
				composer.setSize(window.innerWidth, window.innerHeight);
			});

			// ─── Render loop ───
			const clock = new THREE.Clock();
			const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
			const introFrom = { yaw, pitch };
			const INTRO_DELAY = 0.8;
			const INTRO_LENGTH = 4.5;

			function frame() {
				const t = clock.getElapsedTime();

				if (introActive) {
					const k = easeInOut(Math.max(0, Math.min(1, (t - INTRO_DELAY) / INTRO_LENGTH)));
					yaw = introFrom.yaw + (0 - introFrom.yaw) * k;
					pitch = introFrom.pitch + (0.02 - introFrom.pitch) * k;
					if (k >= 1) introActive = false;
				}

				if (!prefersReducedMotion) {
					skyUniforms.uTime.value = t;
					civMat.uniforms.uTime.value = t;
					// the whole sky wheels as one piece — sky shader and stars share SKY_SPIN
					starsGroup.rotation.y = t * SKY_SPIN;
					if (!dragging && !introActive) yaw += Math.sin(t * 0.11) * 0.00012;
					camera.position.y = 1.7 + Math.sin(t * 1.1) * 0.02;

					// fireflies
					const fp = fireflyGeo.attributes.position.array as Float32Array;
					for (let i = 0; i < fireflyCount; i++) {
						const ph = fireflyPhase[i];
						fp[i * 3] = fireflyBase[i * 3] + Math.sin(t * 0.4 + ph) * 0.9;
						fp[i * 3 + 1] = fireflyBase[i * 3 + 1] + Math.sin(t * 0.7 + ph * 2) * 0.35;
						fp[i * 3 + 2] = fireflyBase[i * 3 + 2] + Math.cos(t * 0.3 + ph) * 0.9;
					}
					fireflyGeo.attributes.position.needsUpdate = true;

					// fire: flicker, breathing flame, embers climbing
					const flicker = 0.84 + 0.16 * Math.sin(t * 11.3) * Math.sin(t * 5.1) + 0.06 * Math.sin(t * 23.7);
					fireLight.intensity = 11 * flicker;
					flameMat.uniforms.uTime.value = t;
					flameMat.uniforms.uIntensity.value = 0.9 + flicker * 0.16;
					{
						const ep = emberGeo.attributes.position.array as Float32Array;
						for (let i = 0; i < EMBER_COUNT; i++) {
							const a = emberSeed[i * 3];
							const life = (t * emberSeed[i * 3 + 2] + emberSeed[i * 3 + 1]) % 1;
							const rise = life * 4.2;
							const spread = 0.18 + life * 0.9;
							ep[i * 3] = Math.cos(a + life * 2.6) * spread;
							ep[i * 3 + 1] = 0.75 + rise;
							ep[i * 3 + 2] = Math.sin(a + life * 2.6) * spread;
						}
						emberGeo.attributes.position.needsUpdate = true;
					}

					// the pages circling the fire, carried on the heat
					pageSprites.forEach((s, i) => {
						const a = t * 0.14 + (i / pageSprites.length) * Math.PI * 2;
						const r = 1.7 + Math.sin(t * 0.5 + i) * 0.16;
						s.position.set(Math.cos(a) * r, 1.7 + Math.sin(t * 0.6 + i * 1.7) * 0.22 + (i % 3) * 0.5, Math.sin(a) * r);
					});

					// plants breathing
					plantSprites.forEach((p) => {
						p.sprite.position.y = p.baseY + Math.sin(t * 0.8 + p.phase) * 0.035;
					});

					doorGlowMat.opacity = 0.07 + Math.sin(t * 1.5) * 0.025;
					pathMats.forEach((m, i) => {
						m.opacity = 0.2 + Math.sin(t * 1.1 + i * 2.1) * 0.06;
					});

					if (t > nextMeteorAt) {
						spawnMeteor(t);
						nextMeteorAt = t + 4 + rng() * 6;
					}
					for (const m of meteors) {
						if (!m.active) continue;
						const age = t - m.t;
						if (age > m.life) {
							m.active = false;
							m.mat.opacity = 0;
							continue;
						}
						const head = m.start.clone().addScaledVector(m.dir, age);
						const tail = head.clone().addScaledVector(m.dir, -0.1);
						const arr = m.line.geometry.attributes.position.array as Float32Array;
						arr[0] = tail.x; arr[1] = tail.y; arr[2] = tail.z;
						arr[3] = head.x; arr[4] = head.y; arr[5] = head.z;
						m.line.geometry.attributes.position.needsUpdate = true;
						m.mat.opacity = Math.sin(Math.PI * (age / m.life)) * 0.9;
					}
				}

				camera.rotation.y = yaw;
				camera.rotation.x = -pitch;

				for (const place of places) {
					const active = place === hoveredPlace;
					place.lights.forEach((l, i) => {
						const base = place.baseIntensity[i];
						const target = active ? base * 1.55 : base;
						// the fire keeps its own flicker; others ease
						if (l !== fireLight) l.intensity += (target - l.intensity) * 0.1;
					});
					const labelMat = place.label.material as THREE.SpriteMaterial;
					labelMat.opacity += ((active ? 0.95 : 0.42) - labelMat.opacity) * 0.12;
				}
				if (hoveredPlace && hoveredPlace.lights[0] === fireLight) {
					fireLight.intensity *= 1.4;
				}

				composer.render();
				requestAnimationFrame(frame);
			}
			frame();
		</script>
	</body>
</html>
